# Pooled Neon connection for the app (host includes -pooler).
DATABASE_URL=

# Direct Neon connection for Drizzle migrations (no -pooler).
DATABASE_URL_DIRECT=

# Better Auth. Generate a long random secret. Do not commit the real value.
BETTER_AUTH_SECRET=

# Production: https://www.rollingsparks.org (canonical; apex redirects to www)
# Local: http://localhost:3000
# Magic links, email codes, and password resets use this host. Must match the
# host browsers land on after DNS/Vercel redirects or session cookies break.
BETTER_AUTH_URL=

# First coach, created on server start when the username is missing.
# Students never use email. Coaches need a real inbox for magic link, email code, and password reset.
COACH_USERNAME=
COACH_PASSWORD=
COACH_EMAIL=

# Neon object storage for private .llsp3 program files and journal media.
# Keys: programs/{userId}/… and journal/{meetingId}/…
# The site stays on Vercel. Uploads use client-side presigned PUT (32 MB max)
# so serverless body limits do not apply. Views/downloads go through the app
# (/versions/.../download and /media/{id}) — not world-public URLs.
# AWS_ACCESS_KEY_ID is the Neon credential token id.
# AWS_SECRET_ACCESS_KEY is the Neon S3 secret. Do not commit real values.
# AWS_ENDPOINT_URL_S3 is the branch storage endpoint.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-1
NEON_STORAGE_BUCKET=programs

# Email. When RESEND_API_KEY is set, mail is sent with Resend.
# When it is empty, development logs the link or code instead. No email is sent.
# EMAIL_FROM must be a sender Resend allows, for example:
# Rolling Sparks <noreply@rollingsparks.org>
RESEND_API_KEY=
EMAIL_FROM=

# Optional secret for the Google Calendar .ics subscribe URL (/api/meetings.ics).
# When set, clients must pass ?token=... (shown on the Meetings page). The feed
# is schedule-only (titles and times); it never includes notes or attendance.
# Generate a long random value. Do not commit the real value.
MEETINGS_ICS_TOKEN=
